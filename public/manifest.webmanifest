{
  "name": "EMON OVERRUNS E-PORTAL",
  "short_name": "E-PORTAL",
  "description": "EMON OVERRUNS E-PORTAL — customers, invoices, payments, employees, billing, order letters and record verification. Pasay City.",
  "id": "/",
  "start_url": "/#dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#1f4a8c",
  "icons": [
    { "src": "brand/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "brand/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "brand/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Verify a Record", "url": "/#verify", "icons": [{ "src": "brand/icon-192.png", "sizes": "192x192" }] },
    { "name": "New Customer", "url": "/#newcustomer", "icons": [{ "src": "brand/icon-192.png", "sizes": "192x192" }] },
    { "name": "Record Payment", "url": "/#newpayment", "icons": [{ "src": "brand/icon-192.png", "sizes": "192x192" }] },
    { "name": "Messages and Community", "url": "/#community", "icons": [{ "src": "brand/icon-192.png", "sizes": "192x192" }] }
  ]
}
